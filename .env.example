# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only: bypasses RLS. Only use in trusted server code
# (e.g. lib/auth/bootstrap.ts, or an edge function that advances pigeon
# flights). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The one admin account (see lib/auth/admin-email.ts). Server-only.
ADMIN_EMAIL=you@example.com

# Used to build the magic-link redirect URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (VAPID). Generate a pair with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is read by the browser (Next.js app) when
# subscribing. VAPID_PRIVATE_KEY is never used by the Next.js app — it's
# consumed by the "send-push-notification" edge function, configured
# separately via `supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...`
# (same keypair). Listed here together just so both halves of the pair live
# in one place.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-k
